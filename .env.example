# ── Upstash Redis – REQUIRED for online chess multiplayer ─────────────────────
# Get FREE credentials at https://console.upstash.com
#   1. Sign up → Create Database → choose region closest to your Vercel region
#   2. Go to "REST API" tab → copy the two values below
#   3. Add them to Vercel: Dashboard → Project → Settings → Environment Variables
#
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── AI Tools (image analyser, document workspace) ──────────────────────────────
# Get an NVIDIA NIM API key at https://build.nvidia.com
# (free tier available, no card required)
#
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m3

# ── Optional aliases (Upstash also exports these names) ────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
